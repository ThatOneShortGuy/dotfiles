#!/usr/bin/env bash
# vpws — named git worktrees ("workspaces") for ~/viewpoint.
#
#   vpws new <name> [branch]   create worktree, link local files, open tabs
#   vpws open <name|main>      open (or focus) the kitty tabs for a workspace
#   vpws use <name|main>       point the docker app/scheduler at a workspace
#   vpws ls                    list workspaces
#   vpws link <name>           (re)create the symlinks to ~/viewpoint
#   vpws rm <name> [--force]   close tabs and remove the worktree (keeps branch)
set -euo pipefail

MAIN="$HOME/viewpoint"
WS_ROOT="$HOME/viewpoint-ws"
ACTIVE_FILE="$WS_ROOT/.active"
LINKS_COMPOSE="$WS_ROOT/.compose.links.yml"
COMPOSE_PROJECT="viewpoint"

# Gitignored / local-only paths symlinked from $MAIN into every workspace.
LINKS=(
    .env
    docker-compose.override.yml
    docker/php-fpm-pool.conf
    vendor
    node_modules
    custom_scripts
    app/Console/Commands/Private
    .claude/settings.local.json
)

# Tabs opened per workspace: "role:command".
TABS=(
    "nvim:nvim ."
    "claude:claude"
)

die() { echo "vpws: $*" >&2; exit 1; }
warn() { echo "vpws: $*" >&2; }

usage() {
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

validate_name() {
    [[ $1 =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "invalid name '$1' (use a-z 0-9 . _ -)"
    [[ $1 != main ]] || die "'main' is reserved"
}

# Resolve a workspace name (or "main") to its directory.
ws_dir() {
    if [[ $1 == main ]]; then
        echo "$MAIN"
    else
        echo "$WS_ROOT/$1"
    fi
}

require_ws() {
    local dir
    dir=$(ws_dir "$1")
    [[ -d $dir ]] || die "no workspace '$1' at $dir"
    echo "$dir"
}

active() { cat "$ACTIVE_FILE" 2>/dev/null || echo main; }

in_kitty() { [[ -n ${KITTY_LISTEN_ON:-} ]] && command -v kitten >/dev/null; }

# Linked dirs carry their own `.gitignore` (e.g. docker/.gitignore: `*`), which git
# can't see through a symlink, so exclude the link paths repo-wide (shared by all
# worktrees).
ensure_excludes() {
    local exclude rel
    exclude="$(git -C "$MAIN" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
    for rel in "${LINKS[@]}"; do
        grep -qxF "/$rel" "$exclude" 2>/dev/null || echo "/$rel" >>"$exclude"
    done
}

cmd_link() {
    local name=$1 dir src dst
    dir=$(require_ws "$name")
    ensure_excludes
    for rel in "${LINKS[@]}"; do
        src="$MAIN/$rel"
        dst="$dir/$rel"
        if [[ ! -e $src ]]; then
            warn "skip $rel (missing in $MAIN)"
            continue
        fi
        if [[ -L $dst ]]; then
            ln -sfn "$src" "$dst"
            continue
        fi
        if [[ -e $dst ]]; then
            # An empty dir is what docker leaves behind for a missing bind-mount file.
            if [[ -d $dst ]] && rmdir "$dst" 2>/dev/null; then
                :
            else
                warn "skip $rel (exists and is not a symlink)"
                continue
            fi
        fi
        mkdir -p "$(dirname "$dst")"
        ln -s "$src" "$dst"
    done
}

cmd_open() {
    local name=$1 dir
    dir=$(require_ws "$name")
    if ! in_kitty; then
        echo "$dir"
        return
    fi
    if kitten @ ls --match-tab "title:^${name}:" >/dev/null 2>&1; then
        kitten @ focus-tab --match "title:^${name}:"
        return
    fi
    local tab role cmd
    for tab in "${TABS[@]}"; do
        role=${tab%%:*}
        cmd=${tab#*:}
        # bash -ic so the shell stays open (with .bashrc) after the program exits.
        kitten @ launch --type=tab --tab-title "$name:$role" --cwd "$dir" \
            bash -ic "$cmd; exec bash" >/dev/null
    done
}

cmd_new() {
    local name=$1 branch=${2:-$1} dir base
    validate_name "$name"
    dir=$(ws_dir "$name")
    [[ ! -e $dir ]] || die "$dir already exists"
    mkdir -p "$WS_ROOT"

    git -C "$MAIN" fetch --quiet origin
    if git -C "$MAIN" show-ref --verify --quiet "refs/heads/$branch"; then
        git -C "$MAIN" worktree add "$dir" "$branch"
    elif git -C "$MAIN" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        git -C "$MAIN" worktree add --track -b "$branch" "$dir" "origin/$branch"
    else
        base=$(git -C "$MAIN" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
        git -C "$MAIN" worktree add --no-track -b "$branch" "$dir" "$base"
    fi

    git -C "$dir" submodule update --init --quiet
    cmd_link "$name"
    cmd_open "$name"
}

write_links_compose() {
    cat >"$LINKS_COMPOSE" <<EOF
# Generated by vpws. Workspace symlinks point at $MAIN, so mount it at the
# same path inside the containers for them to resolve.
services:
  app:
    volumes:
      - $MAIN:$MAIN:ro
  scheduler:
    volumes:
      - $MAIN:$MAIN:ro
EOF
}

cmd_use() {
    local name=$1 dir
    dir=$(require_ws "$name")
    local files=(-f "$dir/docker-compose.yml")
    [[ -e $dir/docker-compose.override.yml ]] && files+=(-f "$dir/docker-compose.override.yml")
    if [[ $name != main ]]; then
        write_links_compose
        files+=(-f "$LINKS_COMPOSE")
    fi
    docker compose -p "$COMPOSE_PROJECT" --project-directory "$dir" "${files[@]}" \
        up -d app scheduler
    mkdir -p "$WS_ROOT"
    echo "$name" >"$ACTIVE_FILE"
    echo "active: $name -> http://localhost:8082"
}

cmd_ls() {
    local cur dir name mark
    cur=$(active)
    for dir in "$MAIN" "$WS_ROOT"/*/; do
        dir=${dir%/}
        [[ -d $dir ]] || continue
        if [[ $dir == "$MAIN" ]]; then name=main; else name=$(basename "$dir"); fi
        [[ $name == "$cur" ]] && mark='*' || mark=' '
        printf '%s %-24s %s\n' "$mark" "$name" "$(git -C "$dir" branch --show-current 2>/dev/null)"
    done
}

cmd_rm() {
    local name=$1 force=${2:-} dir
    validate_name "$name"
    dir=$(require_ws "$name")
    [[ $(active) != "$name" ]] || die "'$name' is the active docker workspace; run 'vpws use main' first"
    if [[ $force != --force && -n $(git -C "$dir" status --porcelain) ]]; then
        die "'$name' has uncommitted changes; commit/stash or pass --force"
    fi
    if in_kitty; then
        kitten @ close-tab --match "title:^${name}:" 2>/dev/null || true
    fi
    # Drop our links first so nothing in $MAIN is ever touched.
    local rel
    for rel in "${LINKS[@]}"; do
        [[ -L $dir/$rel ]] && rm "$dir/$rel"
    done
    # --force is always needed: git refuses to remove worktrees with submodules.
    git -C "$MAIN" worktree remove --force "$dir"
    echo "removed $name (branch kept)"
}

_names() {
    echo main
    for d in "$WS_ROOT"/*/; do
        if [[ -d $d ]]; then basename "$d"; fi
    done
}

[[ $# -ge 1 ]] || usage 1
sub=$1
shift
case $sub in
    new) [[ $# -ge 1 ]] || usage 1; cmd_new "$@" ;;
    open) [[ $# -eq 1 ]] || usage 1; cmd_open "$1" ;;
    use) [[ $# -eq 1 ]] || usage 1; cmd_use "$1" ;;
    ls) cmd_ls ;;
    link) [[ $# -eq 1 ]] || usage 1; validate_name "$1"; cmd_link "$1" ;;
    rm) [[ $# -ge 1 ]] || usage 1; cmd_rm "$@" ;;
    _names) _names ;;
    -h | --help | help) usage ;;
    *) usage 1 ;;
esac
