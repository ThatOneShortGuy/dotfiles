#!/usr/bin/env bash
# vpws — named git worktrees ("workspaces") for ~/viewpoint.
#
#   vpws new <name> [branch] [--no-open]
#                              create worktree, link local files, open tabs
#   vpws open <name|main>      open (or focus) the kitty tabs for a workspace
#   vpws use <name|main>       point docker + `composer run dev` at a workspace
#   vpws dev                   restart `composer run dev` for the active workspace
#   vpws ls                    list workspaces
#   vpws link <name>           (re)create the symlinks to ~/viewpoint + vendor/
#   vpws rm <name> [--force]   close tabs and remove the worktree (keeps branch)
#   vpws clean [-n] [name...]  remove workspaces + branches whose PR is closed/merged
#                              and whose remote branch is deleted (-n: dry run)
set -euo pipefail

MAIN="$HOME/viewpoint"
WS_ROOT="$HOME/viewpoint-ws"
ACTIVE_FILE="$WS_ROOT/.active"
LINKS_COMPOSE="$WS_ROOT/.compose.links.yml"
COMPOSE_PROJECT="viewpoint"
DEV_TAB="vp:dev"

# Gitignored / local-only paths symlinked from $MAIN into every workspace.
# vendor/ is deliberately NOT shared: composer writes paths relative to the real
# vendor dir into its autoloader, so a shared vendor points at whichever
# workspace last ran composer. Each workspace gets its own (see ensure_vendor).
LINKS=(
    .env
    docker-compose.override.yml
    docker/php-fpm-pool.conf
    node_modules
    custom_scripts
    app/Console/Commands/Private
    .claude/settings.local.json
)

# Tabs opened per workspace: "role:command".
TABS=(
    "nvim:tnvim ."
    "claude:claude"
)

die() { echo "vpws: $*" >&2; exit 1; }
warn() { echo "vpws: $*" >&2; }

usage() {
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

validate_name() {
    [[ $1 =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "invalid name '$1' (use a-z 0-9 . _ -)"
    [[ $1 != main ]] || die "'main' is reserved"
}

# Resolve a workspace name (or "main") to its directory.
ws_dir() {
    if [[ $1 == main ]]; then
        echo "$MAIN"
    else
        echo "$WS_ROOT/$1"
    fi
}

require_ws() {
    local dir
    dir=$(ws_dir "$1")
    [[ -d $dir ]] || die "no workspace '$1' at $dir"
    # Not `_names | grep -q`: grep exits on the first match, and with pipefail the
    # resulting SIGPIPE in _names reads as "not found".
    local names
    names=$(_names)
    grep -qxF -- "$1" <<<"$names" || die "$dir is not a git worktree"
    echo "$dir"
}

active() { cat "$ACTIVE_FILE" 2>/dev/null || echo main; }

in_kitty() { [[ -n ${KITTY_LISTEN_ON:-} ]] && command -v kitten >/dev/null; }

# Linked dirs carry their own `.gitignore` (e.g. docker/.gitignore: `*`), which git
# can't see through a symlink, so exclude the link paths repo-wide (shared by all
# worktrees).
ensure_excludes() {
    local exclude rel
    exclude="$(git -C "$MAIN" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
    for rel in "${LINKS[@]}"; do
        grep -qxF "/$rel" "$exclude" 2>/dev/null || echo "/$rel" >>"$exclude"
    done
}

cmd_link() {
    local dir
    dir=$(link_files "$1")
    ensure_vendor "$dir"
}

# Symlink LINKS into the workspace; prints its dir. Leaves vendor/ alone.
link_files() {
    local name=$1 dir src dst
    dir=$(require_ws "$name")
    ensure_excludes
    for rel in "${LINKS[@]}"; do
        src="$MAIN/$rel"
        dst="$dir/$rel"
        if [[ ! -e $src ]]; then
            warn "skip $rel (missing in $MAIN)"
            continue
        fi
        if [[ -L $dst ]]; then
            ln -sfn "$src" "$dst"
            continue
        fi
        if [[ -e $dst ]]; then
            # An empty dir is what docker leaves behind for a missing bind-mount file.
            if [[ -d $dst ]] && rmdir "$dst" 2>/dev/null; then
                :
            else
                warn "skip $rel (exists and is not a symlink)"
                continue
            fi
        fi
        mkdir -p "$(dirname "$dst")"
        ln -s "$src" "$dst"
    done
    # `composer run dev` tails this; tail -f fails if it doesn't exist yet.
    mkdir -p "$dir/storage/logs"
    touch "$dir/storage/logs/laravel.log"
    echo "$dir"
}

# Give the workspace its own vendor/, replacing an old shared symlink.
ensure_vendor() {
    local dir=$1
    [[ -L $dir/vendor ]] && rm "$dir/vendor"
    [[ -d $dir/vendor ]] && return
    echo "vpws: composer install in $dir"
    (cd "$dir" && composer install --no-interaction)
}

cmd_open() {
    local name=$1 dir
    dir=$(require_ws "$name")
    if ! in_kitty; then
        echo "$dir"
        return
    fi
    if kitten @ ls --match-tab "title:^${name}:" >/dev/null 2>&1; then
        kitten @ focus-tab --match "title:^${name}:"
        return
    fi
    local tab role cmd
    for tab in "${TABS[@]}"; do
        role=${tab%%:*}
        cmd=${tab#*:}
        # bash -ic so the shell stays open (with .bashrc) after the program exits.
        kitten @ launch --type=tab --tab-title "$name:$role" --cwd "$dir" \
            bash -ic "$cmd; exec bash" >/dev/null
    done
}

cmd_new() {
    local open=1 args=() arg
    for arg in "$@"; do
        case $arg in
            --no-open) open=0 ;;
            -*) die "unknown flag '$arg'" ;;
            *) args+=("$arg") ;;
        esac
    done
    [[ ${#args[@]} -ge 1 && ${#args[@]} -le 2 ]] || usage 1
    local name=${args[0]} branch=${args[1]:-${args[0]}} dir base
    validate_name "$name"
    dir=$(ws_dir "$name")
    [[ ! -e $dir ]] || die "$dir already exists"
    mkdir -p "$WS_ROOT"

    git -C "$MAIN" fetch --quiet origin
    if git -C "$MAIN" show-ref --verify --quiet "refs/heads/$branch"; then
        git -C "$MAIN" worktree add "$dir" "$branch"
    elif git -C "$MAIN" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        git -C "$MAIN" worktree add --track -b "$branch" "$dir" "origin/$branch"
    else
        base=$(git -C "$MAIN" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
        git -C "$MAIN" worktree add --no-track -b "$branch" "$dir" "$base"
    fi

    git -C "$MAIN" config "vpws.$name.branch" "$branch"
    git -C "$dir" submodule update --init --quiet
    # Open the tabs before composer install so work can start right away; the
    # install runs here while the new tabs have focus.
    dir=$(link_files "$name")
    if ((open)); then cmd_open "$name"; fi
    ensure_vendor "$dir"
}

write_links_compose() {
    cat >"$LINKS_COMPOSE" <<EOF
# Generated by vpws. Workspace symlinks point at $MAIN, so mount it at the
# same path inside the containers for them to resolve.
services:
  app:
    volumes:
      - $MAIN:$MAIN:ro
  scheduler:
    volumes:
      - $MAIN:$MAIN:ro
EOF
}

# Stop any `composer run dev` (ours or started by hand) by sending SIGINT to its
# process group, like Ctrl+C would, then close our dev tab.
stop_dev() {
    local pids pgids pgid i
    pids=$(pgrep -f '/composer run dev' || true)
    if [[ -n $pids ]]; then
        pgids=$(ps -o pgid= -p "${pids//$'\n'/,}" | tr -d ' ' | sort -u)
        for pgid in $pgids; do kill -INT -- "-$pgid" 2>/dev/null || true; done
        for ((i = 0; i < 20; i++)); do
            pgrep -f '/composer run dev' >/dev/null || break
            sleep 0.5
        done
        for pgid in $pgids; do kill -TERM -- "-$pgid" 2>/dev/null || true; done
    fi
    if in_kitty; then
        kitten @ close-tab --match "title:^${DEV_TAB}\$" 2>/dev/null || true
    fi
}

start_dev() {
    local dir=$1
    if ! in_kitty; then
        echo "not in kitty; start it yourself: cd $dir && composer run dev"
        return
    fi
    kitten @ launch --type=tab --keep-focus --tab-title "$DEV_TAB" --cwd "$dir" \
        bash -ic "composer run dev; exec bash" >/dev/null
}

cmd_dev() {
    local dir
    dir=$(require_ws "$(active)")
    stop_dev
    start_dev "$dir"
}

cmd_use() {
    local name=$1 dir
    dir=$(require_ws "$name")
    stop_dev
    local files=(-f "$dir/docker-compose.yml")
    [[ -e $dir/docker-compose.override.yml ]] && files+=(-f "$dir/docker-compose.override.yml")
    if [[ $name != main ]]; then
        write_links_compose
        files+=(-f "$LINKS_COMPOSE")
    fi
    # Whole stack, not just app/scheduler: db/redis/search are shared and their
    # config is identical across workspaces, so compose leaves them running but
    # starts any that are down (search has no restart policy).
    docker compose -p "$COMPOSE_PROJECT" --project-directory "$dir" "${files[@]}" up -d
    mkdir -p "$WS_ROOT"
    echo "$name" >"$ACTIVE_FILE"
    start_dev "$dir"
    echo "active: $name -> http://localhost:8082"
}

# Fills the assoc array named $1 with "branch -> number state" for the newest
# non-fork PR per head branch (state: OPEN, DRAFT, MERGED or CLOSED). Fails
# quietly (empty array) when gh is missing, unauthenticated or offline.
load_prs() {
    local -n _prs=$1
    local branch num state draft
    command -v gh >/dev/null || return 0
    while IFS=$'\t' read -r branch num state draft; do
        [[ $state == OPEN && $draft == true ]] && state=DRAFT
        _prs[$branch]="$num $state"
    done < <(cd "$MAIN" && timeout 5 gh pr list --state all --limit 200 \
        --json number,state,isDraft,headRefName,isCrossRepository \
        -q '[.[] | select(.isCrossRepository | not)] | sort_by(.number) | .[]
            | [.headRefName, .number, .state, .isDraft] | @tsv' 2>/dev/null || true)
}

# Nerd Font octicon + color for a PR state.
pr_symbol() {
    case $1 in
        OPEN) printf '\e[32m' ;;   # git-pull-request, green
        DRAFT) printf '\e[90m' ;;  # git-pull-request-draft, gray
        MERGED) printf '\e[35m' ;; # git-merge, purple
        CLOSED) printf '\e[31m' ;; # git-pull-request-closed, red
    esac
}

cmd_ls() {
    local cur dir name mark branch pr num state color=0 nw=0 bw=0 i
    local names=() branches=()
    local -A prs=()
    [[ -t 1 ]] && color=1
    cur=$(active)
    mapfile -t names < <(_names)
    for name in "${names[@]}"; do
        branches+=("$(git -C "$(ws_dir "$name")" branch --show-current 2>/dev/null)")
        ((${#name} > nw)) && nw=${#name}
        ((${#branches[-1]} > bw)) && bw=${#branches[-1]}
    done
    load_prs prs
    for i in "${!names[@]}"; do
        name=${names[i]}
        branch=${branches[i]}
        [[ $name == "$cur" ]] && mark='*' || mark=' '
        pr=
        if [[ -n $branch && -n ${prs[$branch]:-} ]]; then
            read -r num state <<<"${prs[$branch]}"
            if ((color)); then
                pr="$(pr_symbol "$state") #$num"$'\e[0m'
            else
                pr="#$num ${state,,}"
            fi
        fi
        if [[ -n $pr ]]; then
            printf "%s %-${nw}s  %-${bw}s  %s\n" "$mark" "$name" "$branch" "$pr"
        else
            printf "%s %-${nw}s  %s\n" "$mark" "$name" "$branch"
        fi
    done
}

cmd_rm() {
    local name=$1 force=${2:-} dir
    validate_name "$name"
    dir=$(require_ws "$name")
    [[ $(active) != "$name" ]] || die "'$name' is the active docker workspace; run 'vpws use main' first"
    if [[ $force != --force && -n $(git -C "$dir" status --porcelain) ]]; then
        die "'$name' has uncommitted changes; commit/stash or pass --force"
    fi
    if in_kitty; then
        kitten @ close-tab --match "title:^${name}:" 2>/dev/null || true
    fi
    # Drop our links first so nothing in $MAIN is ever touched.
    local rel
    for rel in "${LINKS[@]}"; do
        [[ -L $dir/$rel ]] && rm "$dir/$rel"
    done
    # --force is always needed: git refuses to remove worktrees with submodules.
    git -C "$MAIN" worktree remove --force "$dir"
    git -C "$MAIN" config --unset "vpws.$name.branch" || true
    echo "removed $name (branch kept)"
}

# The branch a workspace was created for. Workspaces can be switched to other
# branches later, so clean must not rely on the current checkout alone. Falls
# back to the first "checkout: moving from X" in the worktree's reflog, then to
# the current branch.
orig_branch() {
    local name=$1 dir b
    dir=$(ws_dir "$name")
    if b=$(git -C "$MAIN" config --get "vpws.$name.branch"); then
        echo "$b"
        return
    fi
    b=$(git -C "$dir" reflog show --format=%gs HEAD 2>/dev/null |
        sed -n 's/^checkout: moving from \([^ ]*\) to .*/\1/p' | tail -1)
    echo "${b:-$(git -C "$dir" branch --show-current)}"
}

# Prints why <branch> is safe to delete, or fails with the reason to keep it:
# its remote branch is gone, it had a (non-fork) PR, none are open, and the
# local tip is contained in the latest PR's head.
branch_reason() {
    local branch=$1 owner prs pr state head
    [[ -n $branch ]] || { echo "detached HEAD"; return 1; }
    git -C "$MAIN" show-ref --verify --quiet "refs/heads/$branch" ||
        { echo "no local branch '$branch'"; return 1; }
    if [[ -n $(git -C "$MAIN" ls-remote --heads origin "refs/heads/$branch") ]]; then
        echo "remote branch '$branch' still exists"
        return 1
    fi
    owner=$(cd "$MAIN" && gh repo view --json owner -q .owner.login)
    # PRs from this repo (not forks) whose head is this branch, newest first.
    prs=$(cd "$MAIN" && gh pr list --state all --head "$branch" --limit 20 \
        --json number,state,headRefOid,headRepositoryOwner \
        -q "[.[] | select(.headRepositoryOwner.login == \"$owner\")] | sort_by(-.number)
            | .[] | \"\\(.number) \\(.state) \\(.headRefOid)\"")
    [[ -n $prs ]] || { echo "no PR for '$branch'"; return 1; }
    if grep -q ' OPEN ' <<<"$prs"; then
        echo "PR for '$branch' still open"
        return 1
    fi
    read -r pr state head <<<"$prs"
    # Anything committed locally after the PR's last push would be lost.
    if ! git -C "$MAIN" merge-base --is-ancestor "refs/heads/$branch" "$head" 2>/dev/null; then
        echo "local '$branch' has commits not in PR #$pr"
        return 1
    fi
    echo "'$branch' PR #$pr ${state,,}, remote deleted"
}

delete_branch() {
    # -D: squash/rebase merges leave the branch unmerged from git's view.
    if git -C "$MAIN" branch -D "$1" >/dev/null; then
        echo "       deleted branch '$1'"
    else
        warn "failed to delete branch '$1'"
    fi
}

clean_one() {
    local name=$1 dry=$2 dir cur orig reason orig_ok=0 orig_reason=
    dir=$(ws_dir "$name")
    cur=$(git -C "$dir" branch --show-current)
    orig=$(orig_branch "$name")
    if [[ -n $orig && $orig != "$cur" ]] && orig_reason=$(branch_reason "$orig"); then
        orig_ok=1
    fi

    if ! reason=$(branch_reason "$cur"); then
        :
    elif [[ -n $(git -C "$dir" status --porcelain) ]]; then
        reason="uncommitted changes"
    elif [[ $(active) == "$name" ]]; then
        reason="active docker workspace (vpws use main first)"
    else
        # Explicit ifs + `return 0`: a bare `return` after a false `((x)) &&`
        # returns 1, and set -e would then abort the whole clean loop.
        printf 'clean  %-24s %s\n' "$name" "$reason"
        if ((orig_ok)); then printf '       %-24s %s\n' "" "$orig_reason"; fi
        if ((dry)); then return 0; fi
        # Subshell so a failure (die) skips this workspace instead of aborting.
        if ! (cmd_rm "$name" >/dev/null); then
            warn "failed to remove $name"
            return 0
        fi
        echo "       removed workspace"
        delete_branch "$cur"
        if ((orig_ok)); then delete_branch "$orig"; fi
        return 0
    fi

    printf 'keep   %-24s %s\n' "$name" "$reason"
    if ((orig_ok)); then
        # The workspace moved on to another branch; its original one can still go.
        printf '       %-24s %s\n' "" "$orig_reason"
        if ((!dry)); then delete_branch "$orig"; fi
    fi
    return 0
}

cmd_clean() {
    local dry=0 names=() name
    for arg in "$@"; do
        case $arg in
            -n | --dry-run) dry=1 ;;
            -*) die "unknown flag '$arg'" ;;
            *) names+=("$arg") ;;
        esac
    done
    if ((${#names[@]} == 0)); then
        mapfile -t names < <(_names | grep -vx main)
    fi
    git -C "$MAIN" fetch --quiet --prune origin
    for name in "${names[@]}"; do
        validate_name "$name"
        require_ws "$name" >/dev/null
        clean_one "$name" "$dry"
    done
}

# Workspaces are the git worktrees directly under $WS_ROOT. Other folders kept
# there (notes, scratch) are ignored.
_names() {
    local path
    echo main
    git -C "$MAIN" worktree list --porcelain |
        sed -n 's/^worktree //p' |
        while IFS= read -r path; do
            if [[ $(dirname "$path") == "$WS_ROOT" && -d $path ]]; then basename "$path"; fi
        done
}

[[ $# -ge 1 ]] || usage 1
sub=$1
shift
case $sub in
    new) [[ $# -ge 1 ]] || usage 1; cmd_new "$@" ;;
    open) [[ $# -eq 1 ]] || usage 1; cmd_open "$1" ;;
    use) [[ $# -eq 1 ]] || usage 1; cmd_use "$1" ;;
    dev) cmd_dev ;;
    ls) cmd_ls ;;
    link) [[ $# -eq 1 ]] || usage 1; validate_name "$1"; cmd_link "$1" ;;
    rm) [[ $# -ge 1 ]] || usage 1; cmd_rm "$@" ;;
    clean) cmd_clean "$@" ;;
    _names) _names ;;
    -h | --help | help) usage ;;
    *) usage 1 ;;
esac
